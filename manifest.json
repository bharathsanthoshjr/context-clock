{
  "manifest_version": 3,
  "name": "Context Clock",
  "version": "1.0.0",
  "description": "Adds your local date, time, and time zone to messages on ChatGPT, Claude, and Gemini.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Context Clock",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "src/shared/time-context.js",
        "src/shared/settings.js",
        "src/content/platforms/chatgpt.js",
        "src/content/composer.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/shared/time-context.js",
        "src/shared/settings.js",
        "src/content/platforms/claude.js",
        "src/content/composer.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "src/shared/time-context.js",
        "src/shared/settings.js",
        "src/content/platforms/gemini.js",
        "src/content/composer.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}